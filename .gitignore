# Whitelist .gitignore — default-deny. Ignore everything at the top level,
# then re-include only the paths that belong in the repo. New/untracked junk
# and the local dev `config/` are therefore never committed by accident.
/*

# Tracked directories
!/.github/
!/.devcontainer/
!/.agents/
!/custom_components/
!/docs/
!/scripts/

# Tracked top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/README.md
!/hacs.json
!/zensical.en.toml
!/zensical.ko.toml

# Root doc + agent-dir symlink aliases
!/AGENTS.md
!/CLAUDE.md
!/.claude

# GEMINI.md / .gemini may exist locally as the same kind of symlink alias,
# but stay untracked (never whitelisted) — not every collaborator uses Gemini.

# Noise inside tracked directories
__pycache__/
*.py[cod]
.DS_Store

# .agents: track only shared skills/ + settings.json
# (settings.local.json is per-developer; notes/ are local decision logs)
/.agents/*
!/.agents/skills/
!/.agents/settings.json

# Dev-only planning artifacts stay local and untracked (never whitelisted):
#   SPEC.md, tasks/, plan.md, todo.md, spec/
